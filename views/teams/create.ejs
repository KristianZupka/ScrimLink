<form action="/teams" method="POST" enctype="multipart/form-data">

    <input name="teamName" placeholder="Team Name" required>
    <input type="file" name="logo">

    <br><br>

    <input name="player1" placeholder="Player 1" required>
    <input name="player2" placeholder="Player 2" required>
    <input name="player3" placeholder="Player 3" required>
    <input name="player4" placeholder="Player 4" required>
    <input name="player5" placeholder="Player 5" required>

    <br><br>

    <input name="coach" placeholder="Coach">

    <br><br>

    <button type="submit">Create Team</button>

</form>